{
  "name": "angular-realworld",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "mockstart": "ng serve --configuration=mock",
    "build": "ng build",
    "build:mock": "ng build --configuration=mock",
    "build:prod": "ng build --configuration=production",
    "test": "ng test",
    "lint": "ng lint --force",
    "prepare": "husky install",
    "mock-server": "mb --configfile mountebank/imposters.ejs",
    "mock-server:debug": "mb --configfile mountebank/imposters.ejs --loglevel debug",
    "test:e2e": "npx playwright test",
    "test:functional-chromium": "npx playwright test e2e/tests/functional/ --project=chromium --headed",
    "test:business": "npx playwright test e2e/tests/business/"
  },
  "engines": {
    "node": "^20.11.1"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.0.0",
    "@angular/common": "20.0.0",
    "@angular/compiler": "20.0.0",
    "@angular/core": "20.0.0",
    "@angular/forms": "20.0.0",
    "@angular/platform-browser": "20.0.0",
    "@angular/platform-browser-dynamic": "20.0.0",
    "@angular/router": "20.0.0",
    "@rx-angular/cdk": "18.0.0",
    "@rx-angular/template": "18.0.0",
    "marked": "^11.1.0",
    "rxjs": "^7.4.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "20.0.0",
    "@playwright/test": "^1.56.1",
    "@types/jasmine": "^5.1.13",
    "@types/marked": "^6.0.0",
    "@types/node": "^24.9.1",
    "husky": "^8.0.3",
    "jasmine-core": "^5.12.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lint-staged": "^16.1.2",
    "mountebank": "^2.9.1",
    "prettier": "^3.1.1",
    "typescript": "~5.8.3"
  },
  "lint-staged": {
    "*.{ts,html,css,json,md}": "prettier --write"
  }
}
